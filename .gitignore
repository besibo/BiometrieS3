.Rproj.user
.Rhistory
.RData
.Ruserdata

# Quarto
/.quarto/
_site/

# LaTeX auxiliary files
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc
*.lof
*.lot
*.nav
*.snm
*.vrb
*.bcf
*.run.xml
*.auxlock

# Block all PDFs except specific ones
*.pdf
!docs/TP-de-Biométrie-br-Semestre-3-br-.pdf
!images/*.pdf

# Block the problematic numbered duplicate files with spaces
# These are the main cause of slowdown
*" [0-9]*.png"
*" [0-9]*.pdf"
*" [0-9][0-9]*.png"
*" [0-9][0-9]*.pdf"

# Allow essential PNG figure files (needed for HTML book display)
!docs/**/*-1.png
!docs/**/fig-*.png
!docs/**/unnamed-chunk-*.png

# Cache directories
*_cache/

# Temporary files
.DS_Store
*~
*.tmp
